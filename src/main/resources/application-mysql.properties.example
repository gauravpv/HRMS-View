# Copy to application-mysql.properties and set your values.
# Corporate MySQL (default profile when spring.profiles.active includes mysql)
spring.datasource.url=jdbc:mysql://HOST:3306/hrms_bre
spring.datasource.username=YOUR_USER
spring.datasource.password=YOUR_PASSWORD
spring.datasource.hikari.data-source-properties.logSql=true
spring.datasource.hikari.max-lifetime=100000

# Optional JPA (local dev only; production uses ddl-auto=none in application.properties)
# spring.jpa.hibernate.ddl-auto=update
# spring.jpa.properties.hibernate.format_sql=true
